TZ=Europe/Berlin
BASE_URL=https://mail.example.com
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me-please
# "Sign in with Google": a Google Cloud OAuth client (Web application) with the
# redirect URI BASE_URL/api/v1/oauth/google/callback and the Gmail API enabled.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# "Sign in with Microsoft": an Entra app registration (any account type) with the
# redirect URI BASE_URL/api/v1/oauth/microsoft/callback.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# SYNC_INTERVAL=5m
# MAX_ATTACHMENT_MB=25
# NOTIFY_URL=http://apprise:8000/notify/mail
# NOTIFY_FORMAT=apprise
# OPENAI_API_KEY=
# CORE_URL=http://pocket-core:8080
# CORE_REGISTRATION_KEY=
